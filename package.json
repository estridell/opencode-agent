{
  "name": "opencode-agent-workspace",
  "private": true,
  "workspaces": ["packages/telegram"],
  "scripts": {
    "start": "bun run packages/telegram/src/main.ts gateway run",
    "check": "tsc --noEmit",
    "test": "bun test",
    "test:live": "bun run packages/telegram/test/live.ts",
    "test:runtime-update": "bun run packages/telegram/test/runtime-update-live.ts",
    "test:telegram": "bun run packages/telegram/test/telegram-live.ts",
    "setup": "bun run packages/telegram/src/main.ts setup",
    "service:install": "bun run packages/telegram/src/main.ts gateway install"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
